# Copy to .env for local development. Never commit .env.

# Service role: "web" serves pages, "jobs" serves only the Inngest handler
SERVICE_ROLE=web
NODE_ENV=development
# The address the site answers at. Read when needed, so one build serves every environment.
SITE_URL=http://localhost:3000

# Postgres. Option A (default): a Postgres installed on the machine, role ohworks / ohworks, database ohworks.
# Option B: the docker compose container with PostGIS, published on host port 5433.
DATABASE_URL=postgres://ohworks:ohworks@localhost:5432/ohworks
# DATABASE_URL=postgres://ohworks:ohworks@localhost:5433/ohworks

# Redis (docker compose): ISR cache handler, OTP, rate limits, redirect map
REDIS_URL=redis://localhost:6379

# Typesense (docker compose)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=local-dev-key

# Inngest (docker compose dev server; cloud keys in staging/prod)
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Cloudflare origin check (empty locally = check disabled)
ORIGIN_SECRET=

# Cloudflare R2 (S3 API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ohworks-media
# Owners' documents and media kits: a second bucket that is never made public.
R2_PRIVATE_BUCKET=ohworks-owner-files
R2_PUBLIC_BASE_URL=

# Auth
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
PAYLOAD_SECRET=change-me-locally

# Releases only (apps/web/scripts/release.mjs). Leave these out on a development machine.
# SUPER_ADMIN_EMAILS: comma-separated; each becomes a super admin. A release stops if there would be none.
# SUPER_ADMIN_PASSWORD: the first password of a new super admin, replaced at first sign-in (12 characters or more).
# TEAM_ACCOUNTS: optional JSON list of {"email","name","role"} for the rest of the team.
# SUPER_ADMIN_RESET=1: for one release only, when nobody can sign in: puts SUPER_ADMIN_PASSWORD back on the super admins.
# On a development machine SUPER_ADMIN_EMAILS may be set too; new super admins then start with the local password.
# DATABASE_URL_UNPOOLED: a direct database address for creating tables, when DATABASE_URL is a pooled one.

# Tests use their own database, made by `pnpm --filter @ohworks/web test:db`: by default this address
# with the name ohworks_test. The sample owners, sites and pieces live only there. Set it to use another.
# TEST_DATABASE_URL=postgres://ohworks:ohworks@localhost:5432/ohworks_test

# Which environment this is: local, test, preview, staging or production. The API docs at /api/docs/
# show the internal reference everywhere except production. Empty on a development machine; a
# production build without it counts as production.
SITE_ENV=

# Email (Mailpit locally on :1025 / UI :8025)
# Without RESEND_API_KEY, enquiry emails are written to the Outbox in the admin instead of being sent.
RESEND_API_KEY=
# Outside production, only these get real email (addresses or @domains, comma-separated); the rest go
# to the Outbox. On this machine an empty list sends to anyone; in staging and previews it sends to nobody.
EMAIL_ALLOWLIST=
EMAIL_FROM="ohworks <enquiries@ohworks.com>"
SMTP_HOST=localhost
SMTP_PORT=1025

# Maps. MAP_STYLE_URL is the style the live map loads; empty uses the keyless OpenFreeMap style,
# which is for local development. Set it to a MapTiler style address, with its key, in staging and production.
MAP_STYLE_URL=
MAPTILER_API_KEY=
# The place search on the owner's forms. With a key it is Google Places, worldwide: enable
# "Places API (New)" for the key in Google Cloud. The key stays on the server.
# Without a key, a development machine uses the open OpenStreetMap search (Photon), and a production
# build uses the short list of cities held in the code. PLACES_PROVIDER forces one: google, photon or local.
GOOGLE_MAPS_API_KEY=
PLACES_PROVIDER=

# AI
ANTHROPIC_API_KEY=
# Only for a key that is not scoped to a workspace (it starts sk-ant-usr-): the workspace's id.
ANTHROPIC_WORKSPACE_ID=

# Observability
SENTRY_DSN=
# The same DSN for the browser. Written into the build; empty keeps Sentry out of the pages.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# IndexNow (Bing, Yandex, Naver, Seznam). Leave empty locally; pings are skipped without it.
INDEXNOW_KEY=

# City, area and format pages are published only above their thresholds, and answer "not found" below.
# HUB_PREVIEW=1 lets a local machine look at them anyway, marked as previews and never indexed. Test runs
# set it themselves. It is ignored on any site served over https. Do not set it in staging or production.
HUB_PREVIEW=
