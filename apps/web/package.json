{
  "name": "@ohworks/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-map-worker.mjs && next dev --turbopack",
    "build": "node scripts/copy-map-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test visual.e2e.ts --project=desktop --project=phone",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "payload:types": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types",
    "payload:importmap": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:importmap",
    "seed": "node --env-file=../../.env --import tsx src/payload/seed.ts",
    "verify:cms": "node --env-file=../../.env --import tsx src/payload/verify.ts",
    "seed:demo": "node --env-file=../../.env --import tsx src/payload/seed-demo.ts",
    "seed:sites": "node --env-file=../../.env --import tsx src/payload/seed-sites.ts",
    "build:hosted": "node scripts/hosted-build.mjs"
  },
  "dependencies": {
    "@netlify/neon": "^0.1.2",
    "@ohworks/core": "workspace:*",
    "@ohworks/db": "workspace:*",
    "@ohworks/ui": "workspace:*",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "exceljs": "^4.4.0",
    "graphql": "^17.0.2",
    "libphonenumber-js": "^1.13.15",
    "maplibre-gl": "^6.13.0",
    "next": "^15.5.0",
    "payload": "^3.90.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@ohworks/config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supercluster": "^7.1.3",
    "cross-env": "^10.1.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15"
  }
}
