{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @ohworks/web exec next start -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/for-owners/",
        "http://127.0.0.1:3200/newsroom/",
        "http://127.0.0.1:3200/analysis/most-billboards-cannot-be-found-online/",
        "http://127.0.0.1:3200/search/?city=bengaluru",
        "http://127.0.0.1:3200/in/bengaluru/koramangala/hoarding-80-feet-road-ows0001/",
        "http://127.0.0.1:3200/enquire/ows0001/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*(/search/|/enquire/|-ows[0-9]{4}/)).*$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
