{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @ohworks/web exec next start -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/for-owners/",
        "http://127.0.0.1:3200/newsroom/",
        "http://127.0.0.1:3200/analysis/most-billboards-cannot-be-found-online/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
