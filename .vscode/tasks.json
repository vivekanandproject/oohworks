{
  // Terminal > Run Task. "dev server" is the same as Run and Debug's "Run the site", without the
  // debugger. "seed" fills a fresh development database with the team accounts and reference data.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ohworks: dev server",
      "type": "shell",
      "command": "pnpm --filter @ohworks/web dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^x\\b" },
        "background": {
          "activesBegin": "^\\s*▲ Next\\.js",
          "beginsPattern": "^\\s*▲ Next\\.js",
          "endsPattern": "Ready in"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "ohworks: seed the development database",
      "type": "shell",
      "command": "pnpm --filter @ohworks/web seed",
      "problemMatcher": []
    },
    {
      "label": "ohworks: unit tests",
      "type": "shell",
      "command": "pnpm --filter @ohworks/web test",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
